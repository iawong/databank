<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transactionSummary2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".TransactionSummary2">

    <Toolbar
        android:id="@+id/transactionSummaryAppbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/appbar"
        android:elevation="4dp"
        android:title="@string/transaction_summary"
        android:titleTextAppearance="@style/AppbarTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputTransFromDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/transactionSummaryAppbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textInputTransToDate">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transFromDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rowItem"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/transaction_from_date"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputTransToDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/transactionSummaryAppbar"
        app:layout_constraintStart_toEndOf="@id/textInputTransFromDate"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transToDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rowItem"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/transaction_to_date"/>

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/saveDateRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/search"
        android:textColor="@color/white"
        android:backgroundTint="@color/rowItem"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/textInputTransToDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transSumList"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transSumList"
        android:paddingTop="?attr/actionBarSize"
        android:layout_width="0px"
        android:layout_height="0px"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/saveDateRange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </androidx.recyclerview.widget.RecyclerView>

<!--    text field showing the total amount from the search
date range-->
</androidx.constraintlayout.widget.ConstraintLayout>